<?xml version="1.0" encoding="utf-8"?>
<!--
    Xpenzo launcher icon foreground — the brand "X" crossmark (redesign).
    Two crossing strokes centered in the safe zone of the 108x108 canvas:
      • main stroke  : warm cream  (#F4F0E6)
      • accent stroke: moss lime   (#C8D683)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- main stroke: top-left → bottom-right -->
    <path
        android:strokeColor="#F4F0E6"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:pathData="M34,34 L74,74" />

    <!-- accent stroke: top-right → bottom-left -->
    <path
        android:strokeColor="#C8D683"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:pathData="M74,34 L34,74" />
</vector>
