rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Model artifacts — any authenticated user can read (for model update checks)
    match /models/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // CI/CD pipeline only
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Exported CSV / PDF files (user's own exports)
    match /exports/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
